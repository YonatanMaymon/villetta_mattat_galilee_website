# Copy to .env.local for local development (it is git-ignored). In production set these as real
# environment variables on the host.
#
# Nothing here is required to try the site: with no values, `npm run dev` serves a DEMO calendar so the
# booking dialog can be walked from end to end. Fill the values in step by step.

# --- Site ---------------------------------------------------------------------------------------------
# Public address of the deployed site, no trailing slash. Used for canonical/hreflang/sitemap URLs.
VITE_SITE_URL=https://www.your-domain.example

# --- Smoobu ---------------------------------------------------------------------------------------
# Step 1 (read-only availability): the iCal link. The calendar shows real free dates, but nothing can be
# booked online yet - the dialog points guests to the phone instead.
#   Smoobu: Settings > Booking Portals > Individual iCal. The link contains a secret; keep it out of git.
SMOOBU_ICAL_URL=

# Step 2 (real prices and automatic bookings): the API. Needs a Smoobu plan with API access.
#   Smoobu: Settings > Advanced > API Keys. Create a DEDICATED key: a key gives access to the whole
#   account, so keep it secret. Requests are HMAC-signed (the code does this); the older Api-Key header
#   was switched off by Smoobu on 25 September 2026.
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
# The apartment guests book, and (only if the price check asks for it) your Smoobu customer id.
SMOOBU_APARTMENT_ID=
SMOOBU_CUSTOMER_ID=

# --- Email (Resend) -------------------------------------------------------------------------------
# https://resend.com: an API key and a sender on a verified domain. Without these, emails are printed
# to the API console instead of being sent.
RESEND_API_KEY=
MAIL_FROM=Villetta <bookings@your-domain.example>
# Where booking requests and contact messages are delivered.
NOTIFY_TO_EMAIL=villetta@mattat-galilee.co.il

# --- Testing only ---------------------------------------------------------------------------------
# Point the client at a mock or sandbox server instead of the real Smoobu.
# SMOOBU_BASE_URL=
